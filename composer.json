{
    "name": "shoppingfeed/magento2-manager",
    "type": "magento2-module",
    "version": "1.22.0",
    "license": "OSL-3.0",
    "description": "Official module for Shopping Feed integration.",
    "require": {
        "guzzlehttp/guzzle": "^6.3 | ^7.0",
        "shoppingfeed/php-sdk": "^0.13.0 || ^0.14.0 || ^0.15.0",
        "shoppingfeed/php-feed-generator": "^1.2"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "ShoppingFeed\\Manager\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
